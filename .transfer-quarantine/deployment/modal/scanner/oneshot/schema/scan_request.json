{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["sources", "query", "maximum_bytes"],
  "properties": {
    "sources": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "content_base64"],
      "properties": {
        "reference": {"type": "object"},
        "content_base64": {"type": "string", "maxLength": 1398104}
      }
    }},
    "query": {"type": "string", "maxLength": 10000},
    "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "baseline_source_id": {"type": ["string", "null"]}
  }
}
