+      independent_verification:
+        id: build_verification
+        stage: build
+        version: 1
+        # ============================================================
+        # Independent verifier within Build
+        # ============================================================
+
+        workflow:
+          stage_id: build
+          role_id: build_verifier
+          executor_id: build_verifier_executor
+          stage_revision_source: host_controller
+
+          purpose:
+            summary: >-
+              Independently verify the complete integrated source against the frozen
+              specification, accepted criteria, required command profiles, and
+              observable product behavior.
+
+          success_contract:
+            derived_from: accepted_user_intent_and_supplied_criteria
+            success_meaning: Independently demonstrate whether the actual integrated product satisfies the
+              accepted user success criteria using real entrypoints and observable evidence, without assuming
+              Builder success.
+            observable_conditions:
+              - accepted_criteria_observed
+              - required_checks_executed_or_explicitly_blocked
+              - independent_evidence_and_source_identity_verified
+            criteria_completeness_gate: false
+          request_result_exchange:
+            mode: bidirectional_request_result
+            receives_from: host_integrated_build
+            returns_result_to: host_completion_gate
+            routing_authority: host_controller
+            prohibits:
+              - builder_self_certification
+              - source_modification
+            input_request_ref_source: host_request_router
+          input_schema:
+            $schema: https://json-schema.org/draft/2020-12/schema
+            title: build verification input request/result contract
+            type: object
+            additionalProperties: false
+            required:
+              - request_id
+              - request_revision
+              - task_id
+              - user_intent_ref
+              - frozen_specification_ref
+              - integrated_source_ref
+              - completed_task_result_refs
+              - accepted_criterion_refs
+            properties:
+              request_id:
+                type: string
+                pattern: ^[A-Za-z0-9_-]{1,128}$
+              request_revision:
+                type: integer
+                minimum: 1
+              task_id:
+                type: string
+                pattern: ^[A-Za-z0-9_-]{1,128}$
+              user_intent_ref:
+                $ref: urn:oneshot:contract:artifact_ref:1.0
+              frozen_specification_ref:
+                $ref: urn:oneshot:contract:artifact_ref:1.0
+              integrated_source_ref:
+                $ref: urn:oneshot:contract:artifact_ref:1.0
+              completed_task_result_refs:
+                type: array
+                items:
+                  $ref: urn:oneshot:contract:artifact_ref:1.0
+              accepted_criterion_refs:
+                type: array
+                items:
+                  $ref: urn:oneshot:contract:artifact_ref:1.0
+          output_schema:
+            $schema: https://json-schema.org/draft/2020-12/schema
+            title: build verification output request/result contract
+            type: object
+            additionalProperties: false
+            required:
+              - request_id
+              - request_revision
+              - task_id
+              - user_intent_ref
+              - status
+              - input_request_ref
+            properties:
+              request_id:
+                type: string
+                pattern: ^[A-Za-z0-9_-]{1,128}$
+              request_revision:
+                type: integer
+                minimum: 1
+              task_id:
+                type: string
+                pattern: ^[A-Za-z0-9_-]{1,128}$
+              user_intent_ref:
+                $ref: urn:oneshot:contract:artifact_ref:1.0
+              status:
+                type: string
+                enum:
+                  - completed
+                  - failed
+                  - blocked
+                  - not_run
+                  - skipped
+              unresolved:
+                type: array
+                items:
+                  type: string
+              build_validation_record_ref:
+                $ref: urn:oneshot:contract:artifact_ref:1.0
+              criterion_observations:
+                type: array
+                items:
+                  type: object
+              command_result_refs:
+                type: array
+                items:
+                  $ref: urn:oneshot:contract:artifact_ref:1.0
+              integrated_source_digest:
+                type: string
+                pattern: ^[a-f0-9]{64}$
+              limitations:
+                type: array
+                items:
+                  type: string
+              input_request_ref:
+                $ref: urn:oneshot:contract:artifact_ref:1.0
+            allOf:
+              - if:
+                  required:
+                    - status
+                  properties:
+                    status:
+                      const: completed
+                then:
+                  required:
+                    - build_validation_record_ref
+                    - criterion_observations
+                    - integrated_source_digest
+          schema_validation:
+            validator_owner: host
+            dialect: json_schema_2020_12
+            external_contract_refs: resolve_from_registered_contracts
+            unresolved_external_ref: reject
+            exact_request_revision_binding: true
+            user_intent_binding_required: true
+            receipt_authority: trusted_host_only
+            validate_before_persistence: true
+            validate_after_reopen: true
+            failure_output_policy: return_bound_blocked_result_without_fabricated_stage_artifacts
+            cross_reference_validation:
+              - request_id
+              - request_revision
+              - task_id
+              - user_intent_ref
+              - parent_artifact_revision
+              - receipt_subject_and_issuer
+            require_output_input_request_ref_match: true
+          inputs:
+            required:
+              - input_id: input_request
+                contract_id: build_validation_input_request
+                schema_source: workflow.input_schema
+                resolution: host_bound_request_artifact
+                source: host_request_router
+                receipt_required: true
+              - input_id: workflow_input
+                contract_id: workflow_input
+                resolution: exact_artifact_ref
+
+              - input_id: research_record
+                contract_id: research_record
+                resolution: exact_artifact_ref
+
+              - input_id: audit_discovery_record
+                contract_id: audit_discovery_record
+                resolution: exact_artifact_ref
+
+              - input_id: frozen_specification
+                contract_id: build_specification
+                resolution: exact_artifact_ref
+                receipt_required: true
+
+              - input_id: build_task_set
+                contract_id: build_task_set
+                resolution: exact_artifact_ref
+
+              - input_id: completed_task_results
+                contract_id: task_integration_result
+                resolution: exact_artifact_ref
+                multiple: true
+
+              - input_id: integrated_source
+                contract_id: integrated_source_snapshot
+                resolution: exact_artifact_ref
+
+              - input_id: tool_registry_snapshot
+                contract_id: tool_registry_snapshot
+                resolution: exact_artifact_ref
+
+              - input_id: sandbox_profile
+                contract_id: sandbox_profile
+                resolution: exact_artifact_ref
+
+          execution:
+            provider_session_required: true
+
+            model_loop:
+              enabled: true
+              maximum_tool_calls: 160
+              maximum_validation_attempts: 3
+              completion_condition: build_validation_record_submitted
+
+            required_work:
+              - step_id: load_validation_scope
+                produces:
+                  - accepted_requirements
+                  - acceptance_criteria
+                  - frozen_actions
+                  - completed_task_results
+
+              - step_id: verify_task_completion
+                produces:
+                  - task_completion_observations
+
+              - step_id: resolve_validation_tools
+                produces:
+                  - resolved_test_invocations
+
+              - step_id: execute_required_checks
+                produces:
+                  - command_results
+
+              - step_id: observe_product_behavior
+                produces:
+                  - criterion_observations
+
+              - step_id: compare_against_criteria
+                produces:
+                  - criterion_results
+
+              - step_id: submit_validation_record
+                produces:
+                  - build_validation_record_candidate
+
+          tool_projection:
+            registry_ref_source: package_lock
+
+            capabilities:
+              - capability_id: artifacts.get_artifact
+                wire_name: get_artifact
+                permission_token: artifacts.read
+
+              - capability_id: repository.list_files
+                wire_name: list_files
+                permission_token: validation_repository.read
+
+              - capability_id: repository.read_file
+                wire_name: read_file
+                permission_token: validation_repository.read
+
+              - capability_id: repository.search_files
+                wire_name: search_files
+                permission_token: validation_repository.search
+
+              - capability_id: sandbox.run_registered
+                wire_name: run_verification
+                permission_token: validation_tool.execute
+
+              - capability_id: task_management.get_status
+                wire_name: get_task_status
+                permission_token: task_management.read
+
+            command_policy:
+              raw_argv_allowed: false
+              command_profile_source: frozen_specification
+              registry_resolution_required: true
+              effect_time_resolution_required: true
+
+          outputs:
+            - output_slot: primary
+              contract_id: build_validation_record
+              contract_version: "1.0"
+              media_type: application/json
+
+              required_sections:
+                - workflow_input_ref
+                - frozen_specification_ref
+                - task_set_ref
+                - completed_task_refs
+                - integrated_source_ref
                 - integrated_source_digest
